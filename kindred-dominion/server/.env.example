# Backend-only. Copy to server/.env.local; never commit the filled file.
APP_ENV=dev
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=kindred_dominion_dev
PGUSER=kindred_dev
PGPASSWORD=replace-privately
API_HOST=127.0.0.1
API_PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Generate at least 32 random bytes with npm run backend:configure.
SESSION_SECRET=replace-with-generated-secret
SESSION_HOURS=168
COOKIE_SECURE=false
REGISTRATION_MODE=invite
REGISTRATION_PER_HOUR=10
LOG_LEVEL=info
# Optional V1.4 local-testing acquisition. DEV/integration only; hosted use refuses true.
# One sampler per account after a verified normal computer battle. Not a production economy.
LOCAL_TEST_ACQUISITION=false
LOCAL_TEST_PACK_CARDS=a001,m001,c001

# DEV economy opt-in; defaults off for hosted TEST and always disabled in PROD.
# Publish a validated configuration in protected Control before rewards begin.
ECONOMY_ENABLED=false
