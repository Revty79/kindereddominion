import fs from "node:fs/promises";
import {DEFAULT_STARTERS} from "../server/starter-rules";
import {starterRecipeDigest} from "../server/starters";
import {currentOwnerContent} from "../src/content/current";
import {integratedEconomyModel} from "./v15-model";
const pack=currentOwnerContent(),rationale=JSON.parse(await fs.readFile("docs/v1.6a/SELECTION-RATIONALE.json","utf8")),lines=["# V1.6A - Forty-copy starting collection proposals","","**Owner review required before hosted activation.** Both new-player and existing-account activation default to false. This is a 40-copy collection, containing 30 unique identities and ten additional bound copies. Standard battle decks remain 15 cards with the existing card/game-mode limits.","","All 150 executable cards were evaluated for placement, influence, power, actual effects, evolution dependencies, copy limits and early/late use: [complete card evaluation](v1.6a/CARD-EVALUATION.md), [full mechanical evaluation data](v1.6a/CARD-EVALUATION.json). Rarity, names and artwork were not the selection rule.","",`Recipe version: \`${DEFAULT_STARTERS.recipeVersion}\`. Exact proposal digest: \`${starterRecipeDigest(DEFAULT_STARTERS)}\`. This digest identifies the definitions, not an owner approval.`,"","Every Kindred receives one copy of each of its original 30 founders, plus the ten rows below. Each selected identity receives one extra copy. Purchased/earned copies remain additional to this grant. Earlier recipients do not receive another ten merely because a new recipe version is published.",""];
const list=(ids:string[])=>{const counts=new Map<string,number>();for(const id of ids)counts.set(id,(counts.get(id)??0)+1);return [...counts].map(([id,n])=>`${pack.cards.find(c=>c.id===id)!.collectible!.number} ${pack.cards.find(c=>c.id===id)!.name}${n>1?" ×"+n:""}`).join("; ");};
for(const d of DEFAULT_STARTERS.definitions){lines.push(`## ${d.kindred}`,"","| Permanent ID / creature | Existing placement / printed power | Actual ability or tactical role | Extra | Selection reason | Balance concern |","| --- | --- | --- | --- | --- | --- |");for(const r of d.additional){const c=pack.cards.find(c=>c.id===r.cardId)!,why=rationale[c.id];if(!why)throw Error("Missing manually reviewed selection rationale");lines.push(`| ${c.collectible!.number} ${c.name} | ${c.type}, rank ${c.rank}; power ${c.power}; standard cap ${c.maxCopies??2} | ${c.text.replaceAll("|","/")} | +${r.quantity} | ${why.reason} | ${why.concern} |`);}lines.push("",`Recommended **${d.recommended.name}** (15 cards): ${list(d.recommended.cards)}.`,"");for(const a of d.alternatives)lines.push(`Alternative **${a.name}** (15 cards): ${list(a.cards)}.`,"");}
lines.push("## Review and activation boundaries","","These decks deliberately repeat foundational cards and retain usable development/evolution routes. They do not promise equal AI win rates or human balance. [Repeatable balance results](v1.6a/BALANCE.json) and [actual turn-by-turn development metrics](v1.6a/DEVELOPMENT-METRICS.json) are reported separately. Existing high-power efficiency, continuous enhancement/weakening and death/resurrection combinations must be distinguished from defects introduced by these starting quantities.","","The protected Starter collections panel can edit versions, quantities and all three decks, validate/publish an inactive proposal, show exact ownership deltas, enable DEV grants, and record owner approval before hosted activation. Historical grants retain the exact selected configuration and content snapshot. Unknown/conflicting original Kindreds are blocked for authorized review. Backfill never replaces any existing deck.");
await fs.writeFile("docs/V1.6A-STARTER-PROPOSALS.md",lines.join("\n")+"\n");
const before=integratedEconomyModel({starterCopies:30}),after=integratedEconomyModel({starterCopies:40});const profiles=after.profiles.map((p,i)=>{const old=before.profiles[i];if(p.ownedCopies-old.ownedCopies!==10||p.uniqueCards!==old.uniqueCards||p.paidPacks!==old.paidPacks||p.goldRemaining!==old.goldRemaining)throw Error("Starter economy compatibility failed");return {id:p.id,legacyOwnedCopies:old.ownedCopies,expandedOwnedCopies:p.ownedCopies,uniqueCards:p.uniqueCards,paidPacks:p.paidPacks,giftPacks:p.giftPacks,completionDay:p.completionDay,goldRemaining:p.goldRemaining,additionalBoundStarterCopies:10,conserved:p.conserved};});await fs.writeFile("docs/v1.6a/ECONOMY.json",JSON.stringify({proposalOnly:true,runtimeActivationAutomatic:false,startingUnique:30,startingPlayableCopies:40,boundAdditional:10,remainingUnique:120,maximumFiveNewBoosters:24,firstCopy:after.firstCopy,profiles,tradingSupplyUnchanged:JSON.stringify(before.market)===JSON.stringify(after.market),actualRevenue:0,assumptions:"The legacy default remains available while starter activation is pending. V1.6A explicitly models the forty-copy proposal. Only subsequently earned/tradeable lots enter the trading model; these ten bound copies supply no tradable inventory."},null,2)+"\n");console.log(JSON.stringify({kindreds:5,additionalSelections:50,recommendedDecks:5,alternatives:10,digest:starterRecipeDigest(DEFAULT_STARTERS),economyConserved:true}));
