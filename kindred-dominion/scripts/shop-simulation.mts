import fs from "node:fs/promises";
import {shopSimulation} from "./shop-model";
import {ownerContent} from "../src/content/owner";
import {DEFAULT_SHOP} from "../server/shop-rules";
const result=shopSimulation();await fs.writeFile("docs/V1.5D-SIMULATION.json",JSON.stringify(result,null,2)+"\n");
const pack=ownerContent(),rows=pack.cards.map(card=>{const rationale=card.type==="evolution"?"Evolution payoff and specialist deck construction; lower prerequisite forms remain available through Gold completion and direct acquisition.":card.type==="replacement"?"Replacement utility and formation timing; rarity reflects collection variety rather than combat-stat scaling.":card.abilities.length||card.continuous?.length||card.protections?.length?"Tactical ability or protection identity; utility is evaluated independently of printed power.":card.rank<=2?"Accessible early formation and prerequisite coverage; maintains an ordinary low-rank collection foundation.":"Formation progression and thematic variety; all first copies retain an ordinary Gold route.";return `| ${card.collectible!.number} | ${card.name} | ${DEFAULT_SHOP.rarities[card.id]} | ${card.type} / ${card.rank} / ${card.power} | ${rationale} |`;});
