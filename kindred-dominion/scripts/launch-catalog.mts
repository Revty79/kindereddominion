import fs from "node:fs";
import {DEFAULT_SHOP,inPool,rarities,ADDITIONAL_PRICES,type Product} from "../server/shop-rules";
import {DEFAULT_COMMERCE} from "../server/commerce-rules";
import {DEFAULT_STARTERS} from "../server/starter-rules";
import {resolveProduct} from "../server/shop-catalog";
import {bundleQuantities} from "../server/shop-quantities";
import {drawPack,seededRandom} from "../server/shop-draw";
import {currentOwnerContent} from "../src/content/current";
const pack=currentOwnerContent(),shop=structuredClone(DEFAULT_SHOP),commerce=structuredClone(DEFAULT_COMMERCE),registry=JSON.parse(fs.readFileSync("public/assets/manifest.json","utf8"));
// Retain historical identities for receipts, with explicit proposed retirement.
// Applying this proposal is an authenticated admin publication, never a seed.
for(const p of shop.products)if(p.id.endsWith("-extra-set")||p.type==="booster"&&p.mode==="additional"&&p.id.startsWith("founding-")){p.status="archived";p.enabled=false;}
for(const p of commerce.products)if(p.shopProducts.some(id=>shop.products.find(p=>p.id===id)?.status==="archived")){p.status="archived";p.enabled=false;}
const artwork=(id:string)=>{const ref=pack.metadata[id].artworkRef,asset=registry.assets.find((a:any)=>a.id===ref?.id&&a.revision===ref?.revision);if(!asset)throw Error("Published founding artwork missing for "+id);return {id:asset.id,revision:asset.revision,path:asset.path,sha256:asset.sha256};};
const describe=(p:Product)=>{const cards=pack.cards.filter(c=>inPool(c,p.pool,shop)),plan=bundleQuantities(p,cards.map(c=>c.id));return {definition:p,activation:p.status==="draft"?"awaiting exact V1.6A owner approval":p.status==="archived"?"legacy identity retained; proposed retirement":p.testOnly?"designated sandbox accounts only":"requires explicit admin publication in DEV/TEST",artwork:p.artwork??null,contents:p.type==="bundle"?cards.map(c=>({id:c.id,collectibleId:c.collectible!.number,quantity:plan.targets[c.id],rarity:shop.rarities[c.id],artwork:artwork(c.id)})):null,pool:cards.map(c=>c.id),totalTargetCopies:p.type==="bundle"?plan.fullTotal:null,slotProbabilities:p.slots,eligibility:p.mode==="first_copy"?"Not owned and never acquired in lifetime; reduced packs prorate, no eligible cards disables purchase.":p.mode==="completion"?"Maximum of zero or target minus total owned quantity; starters and reserved copies count. Prorate missing units/full target units, then ceiling and discount.":"Full additional copies, even if all identities already owned; published availability, account and funding restrictions apply.",tradeability:p.testOnly?"Sandbox assets bound":p.tradeable?"Own provenance lot; purchased funds impose configured hold; administrator-funded assets bound":"Bound",randomizedCommercialFundingAllowed:false};};
const state={cards:pack.cards,rules:shop},direct=pack.cards.flatMap(c=>[resolveProduct(state,"card-first-"+c.id)!,resolveProduct(state,"card-additional-"+c.id)!]);
const simulation:any={seed:163400,samplesPerBooster:10000,assumptions:"No resale, no paid trading fees, no actual revenue. Initial full founding pool; rarity probabilities do not imply gameplay power.",boosters:{}};
for(const id of["dominion-booster","collector-booster"]){const p=shop.products.find(p=>p.id===id)!,random=seededRandom(simulation.seed),counts=Object.fromEntries(rarities.map(r=>[r,0]));let value=0;for(let n=0;n<simulation.samplesPerBooster;n++)for(const draw of drawPack(p,pack.cards,shop,new Set(),random)){counts[draw.rarity]++;value+=ADDITIONAL_PRICES[draw.rarity];}simulation.boosters[id]={configuredPrice:p.price,expectedDirectCopyPrice:Math.round(value/simulation.samplesPerBooster*100)/100,meanRareOrBetterCopies:(counts.rare+counts.epic+counts.legendary)/simulation.samplesPerBooster,observedRarityCounts:counts,configuredSlotWeights:p.slots.map(s=>s.weights)};}
simulation.firstCollection={startingIdentities:30,totalIdentities:150,remainingIdentities:120,ordinaryFiveCardPacks:24,ordinaryGold:6000,targetedGold:7200,fortyCopyStarterStillHasUniqueIdentities:30};
simulation.sets=shop.products.filter(p=>p.type==="bundle"&&p.id.match(/-(standard|deluxe)-additional$/)).map(p=>{const ids=pack.cards.filter(c=>inPool(c,p.pool,shop)).map(c=>c.id),plan=bundleQuantities(p,ids),direct=ids.reduce((n,id)=>n+ADDITIONAL_PRICES[shop.rarities[id]]*plan.targets[id],0);return {id:p.id,priceAether:p.price,targetCopies:plan.fullTotal,individualPriceAether:direct,discountPercent:Math.round((1-p.price/direct)*10000)/100};});
simulation.packageRates=commerce.products.filter(p=>p.type==="aether").map(p=>({id:p.id,usdMinor:p.amountMinor,aether:p.aether,usdCentsPerAether:p.amountMinor/p.aether}));
const document={format:"kindred-dominion-proposed-launch-catalog",schema:1,contentVersion:pack.id,proposalOnly:true,liveSalesEnabled:false,deluxeOwnerApproved:DEFAULT_STARTERS.hostedApproval!==null,randomizedCommercialFundingAllowed:false,shop,commerce,products:[...shop.products,...direct].map(describe),simulations:simulation};
const output="docs/v1.6h/LAUNCH-CATALOG.json",bytes=JSON.stringify(document,null,2)+"\n";
if(process.argv.includes("--check")){if(fs.readFileSync(output,"utf8").replace(/\r\n/g,"\n")!==bytes)throw Error("Launch catalog differs from source. Regenerate and review it.");}else fs.writeFileSync(output,bytes);
console.log(JSON.stringify({catalog:output,products:document.products.length,cashProducts:commerce.products.length,deluxeApproved:document.deluxeOwnerApproved,liveSalesEnabled:false,simulations:simulation}));
