const config=readConfig();if(config.environment!=="integration"||config.port===5432||config.apiPort===3001||new URL(config.origin).port==="5173")throw Error("Use a registered isolated acceptance target and dedicated ports.");
const base=fs.readFileSync(process.env.KINDRED_ENV_FILE!,"utf8"),directory=".local/v1.5g/browser-flows";fs.mkdirSync(directory,{recursive:true});
const flows=[['economy','KINDRED_ECONOMY_ACCEPT'],['shop','KINDRED_SHOP_ACCEPT'],['trading','KINDRED_TRADING_ACCEPT'],['trading-safety','KINDRED_TRADING_SAFETY_ACCEPT'],['commerce','KINDRED_COMMERCE_ACCEPT'],['commerce-admin','KINDRED_COMMERCE_ADMIN_ACCEPT'],['control','KINDRED_CONTROL_ACCEPT'],['release','KINDRED_RELEASE_ACCEPT']];const selected=process.argv.slice(2);const results:any[]=fs.existsSync(`${directory}/results.json`)?JSON.parse(fs.readFileSync(`${directory}/results.json`,"utf8")):[];
for(const [name,flag] of flows.filter(([name])=>!selected.length||selected.includes(name))){const file=`${directory}/${name}.env`;let text=base.replace(/^SESSION_SECRET=.*$/m,'SESSION_SECRET='+crypto.randomBytes(48).toString('base64url')).replace(/^REGISTRATION_MODE=.*$/m,'REGISTRATION_MODE='+(name==='control'?'invite':'local'));text=text.replace(/^LOCAL_TEST_ACQUISITION=.*\r?\n?/gm,'').replace(/^ECONOMY_ENABLED=.*\r?\n?/gm,'')+`\nLOCAL_TEST_ACQUISITION=${name==='release'}\nECONOMY_ENABLED=${name!=='release'}\n`;fs.writeFileSync(file,text,{mode:0o600});const env={...process.env,KINDRED_ENV_FILE:file,[flag]:'yes'};for(const [,other]of flows)if(other!==flag)delete env[other];const start=Date.now(),r=spawnSync(process.execPath,['node_modules/@playwright/test/cli.js','test','--config','server/playwright.config.ts',`server/tests/browser/${name}.spec.ts`],{env,encoding:'utf8',windowsHide:true,maxBuffer:30*1024*1024});fs.writeFileSync(`${directory}/${name}.log`,r.stdout+'\n'+r.stderr);const old=results.findIndex(v=>v.flow===name);if(old>=0)results.splice(old,1);results.push({flow:name,passed:r.status===0,elapsedSeconds:Math.round((Date.now()-start)/1000),isolatedSessionNamespace:true});console.log(JSON.stringify(results.at(-1)));if(r.status!==0){fs.writeFileSync(`${directory}/results.json`,JSON.stringify(results,null,2));throw Error(`Compiled ${name} acceptance failed; inspect its ignored private log. No security limit was relaxed.`);}}
