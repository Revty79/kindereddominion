import fs from "node:fs";
import {readConfig} from "../server/config";
import {database} from "../server/db";
import {stripeClient,inspectStripeConnection} from "../server/provider-stripe";
import {selectedConfiguration} from "../server/configuration";
import {economyDigest} from "../server/economy-hash";
import {ApiError} from "../server/errors";
async function main(){const config=readConfig(),command=process.argv[2];if(config.environment==="prod")throw Error("Production commerce is disabled.");const sdk=stripeClient(config,command==="catalog"),connection=await inspectStripeConnection(config,sdk,command==="verify"&&process.argv.includes("--pin-account"));
 if(command==="verify"){if(process.argv.includes("--pin-account")&&!config.stripe.accountId){const file=process.env.KINDRED_ENV_FILE??"server/.env.local";let value=fs.readFileSync(file,"utf8");value=/^STRIPE_ACCOUNT_ID=.*$/m.test(value)?value.replace(/^STRIPE_ACCOUNT_ID=.*$/m,"STRIPE_ACCOUNT_ID="+connection.accountId):value+"\nSTRIPE_ACCOUNT_ID="+connection.accountId+"\n";fs.writeFileSync(file,value,{mode:0o600});}console.log(JSON.stringify({connected:true,sandbox:true,accountId:connection.accountId,apiVersion:connection.apiVersion,credentialsPrinted:false}));return;}
 if(command!=="catalog")throw Error("Use verify or catalog.");const pool=database(config);try{const selected=await selectedConfiguration(pool,"commerce");if(!selected)throw Error("Publish a reviewed sandbox commercial configuration first.");const products=(await pool.query("SELECT * FROM kd.commerce_product_snapshot WHERE config_version=$1 ORDER BY product_id",[selected.id])).rows.filter(r=>r.snapshot.product.enabled&&r.snapshot.product.status==="published");if(!process.argv.includes("--apply")){console.log(JSON.stringify({dryRun:true,sandbox:true,products:products.map(p=>({id:p.product_id,amountMinor:p.snapshot.product.amountMinor,currency:p.snapshot.product.currency})),instruction:"Review this catalog, then repeat with --apply to create sandbox Products and Prices."}));return;}let created=0,reused=0;for(const row of products){if(economyDigest(row.snapshot)!==row.digest||row.snapshot.product.liveEligible!==false||row.snapshot.product.sandbox!==true)throw Error("Snapshot integrity failed.");const p=row.snapshot.product,existing=(await pool.query("SELECT * FROM kd.commerce_provider_product WHERE provider='stripe' AND provider_account=$1 AND config_version=$2 AND product_id=$3",[connection.accountId,selected.id,p.id])).rows[0];if(existing){const price=await sdk.prices.retrieve(existing.provider_price_id);if(price.livemode!==false||price.unit_amount!==p.amountMinor||price.currency!==p.currency||existing.digest!==row.digest)throw Error("Existing sandbox mapping requires investigation.");reused++;continue;}const metadata={kindred_product:p.id,kindred_config:selected.id},product=await sdk.products.create({name:p.name,description:p.description,metadata},{idempotencyKey:`kindred-product:${connection.accountId}:${selected.id}:${p.id}`});if(product.livemode!==false)throw Error("Live provider objects are prohibited.");const price=await sdk.prices.create({currency:p.currency,unit_amount:p.amountMinor,product:product.id,metadata},{idempotencyKey:`kindred-price:${connection.accountId}:${selected.id}:${p.id}`});if(price.livemode!==false||price.unit_amount!==p.amountMinor||price.currency!=="usd")throw Error("Provider Price verification failed.");await pool.query("INSERT INTO kd.commerce_provider_product(provider,provider_account,config_version,product_id,provider_product_id,provider_price_id,digest) VALUES('stripe',$1,$2,$3,$4,$5,$6) ON CONFLICT DO NOTHING",[connection.accountId,selected.id,p.id,product.id,price.id,row.digest]);created++;}console.log(JSON.stringify({sandbox:true,configVersion:selected.id,created,reused,liveProductsCreated:false,credentialsPrinted:false}));}finally{await pool.end();}}
main().catch(e=>{console.error(JSON.stringify({ok:false,code:e instanceof ApiError?e.code:"sandbox_setup_failed",message:"Sandbox setup could not complete. Review private configuration, database migrations and documented restricted-key permissions. No credentials or provider error payloads were logged."}));process.exitCode=1;});
