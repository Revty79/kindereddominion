# Examples only. Check host listeners and choose an unused port before startup.
KINDRED_PORT=18083
KINDRED_BIND=127.0.0.1
# Set this to: git rev-parse HEAD
KINDRED_REVISION=replace-with-checked-out-commit
KINDRED_CONTENT_ID=founding-kindreds-owner-v1
# Private files outside the source checkout on a future authorized Ubuntu host.
KINDRED_BACKEND_ENV_FILE=/etc/kindred-dominion/test/backend.env
KINDRED_MIGRATION_ENV_FILE=/etc/kindred-dominion/test/migrations.env
