{
  "name": "kindred-dominion",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test:browser": "playwright test",
    "validate:assets": "node scripts/validate-assets.mjs",
    "prebuild": "node scripts/validate-assets.mjs",
    "balance": "node scripts/balance.mjs",
    "content:import": "node scripts/import-content.mjs",
    "content:export": "node scripts/export-content.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0",
    "sharp": "^0.35.5",
    "esbuild": "^0.28.2"
  }
}
