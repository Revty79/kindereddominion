{
  "name": "kindred-dominion",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test:browser": "playwright test",
    "validate:assets": "node scripts/validate-assets.mjs",
    "prebuild": "node scripts/validate-assets.mjs",
    "balance": "node scripts/balance.mjs",
    "content:import": "node scripts/import-content.mjs",
    "content:export": "node scripts/export-content.mjs",
    "validate:v1.3a": "node scripts/validate-v1.3a.mjs",
    "build:player": "node scripts/build-player.mjs",
    "validate:owner": "node scripts/validate-owner.mjs",
    "backend:configure": "node scripts/configure-backend.mjs",
    "backend:dev": "tsx watch server/index.ts",
    "backend:start": "node server-dist/index.mjs",
    "backend:build": "tsc --noEmit -p server/tsconfig.json && node scripts/build-backend.mjs",
    "db:status": "tsx server/cli.ts status",
    "db:migrate": "tsx server/cli.ts migrate",
    "db:seed": "tsx server/cli.ts seed",
    "db:create-test": "node scripts/pg-isolate.mjs start",
    "db:backup": "tsx server/cli.ts backup",
    "db:restore-test": "tsx server/cli.ts restore-test",
    "db:reset-dev": "tsx server/cli.ts reset-dev",
    "test:database": "vitest run --config server/vitest.config.ts",
    "account:invite": "tsx server/cli.ts invite",
    "account:role": "tsx server/cli.ts role",
    "dev:all": "node scripts/dev-all.mjs",
    "test:accounts:browser": "playwright test --config server/playwright.config.ts",
    "account:password-reset": "tsx server/cli.ts password-reset",
    "account:status": "tsx server/cli.ts account-status",
    "validate:backend-isolation": "node scripts/verify-backend-isolation.mjs",
    "build:control": "node scripts/build-control.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@xmldom/xmldom": "^0.9.12",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "node-pg-migrate": {
      "glob": "14.0.6"
    }
  }
}
